# PostgreSQL connection string — Railway Postgres veya yerel PostgreSQL
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/labcore

# SADECE ilk kuruluma özel yönetici hesabı. Gerçek şifreleri GitHub'a yüklemeyin.
# Kurulum sonrası bu iki değeri sunucu ortamından kaldırabilirsiniz.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Production URL: https://uygulama-adresi.example
# Local Vite: http://localhost:5173
APP_ORIGIN=http://localhost:5173
PORT=4000
NODE_ENV=development
