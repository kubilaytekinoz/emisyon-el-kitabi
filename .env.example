# LABCORE - Kendi Linux sunucumuzda SQLite ile kurulum
# Gelistirme: ./data/labcore.sqlite
# Linux sunucusu: /var/lib/labcore/labcore.sqlite
DATABASE_PATH=./data/labcore.sqlite

# Yalnizca ilk kurulumda gereken yonetici hesabi.
# Sifreyi asla GitHub'a kaydetmeyin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Uygulamanin gercek adresi; canlida HTTPS olmalidir.
APP_ORIGIN=http://localhost:5173
PORT=4000
NODE_ENV=development
