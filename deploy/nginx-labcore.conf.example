# BU DOSYA TAM BIR NGINX SERVER BLOĞU DEGILDIR.
# Mevcut /kopru sitesini sunan HTTPS "server { ... }" BLOĞUNUN ICINE
# SADECE asagidaki IKI LOCATION eklenir.
#
# ONCE mevcut Nginx yapilandirmasini yedekleyin.
# Mevcut /kopru location, proxy_pass, upstream veya root ayarlarina DOKUNMAYIN.
#
# /rehber yolunu /rehber/ adresine normalize eder.
location = /rehber {
    return 308 /rehber/;
}

# Dikkat: proxy_pass URL'inde SONDA / OLMAMALI.
# Bu sayede /rehber/api/login istegi upstream'de de
# /rehber/api/login olarak kalir; /kopru yoluyla çakışmaz.
location ^~ /rehber/ {
    proxy_pass http://127.0.0.1:4100;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_read_timeout 60s;
    client_max_body_size 1m;
}
# Kontrol: sudo nginx -t
# Basariliysa: sudo systemctl reload nginx
# Sonra hem /kopru hem /rehber/ adresini ayrı ayrı kontrol edin.
